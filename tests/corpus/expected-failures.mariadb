# Expected Oracle-compatibility failures for DBSACI_CORPUS_BACKEND=mariadb.
# One group::case per line. Ledger mode (DBSACI_CORPUS_LEDGER=1) exits 0 iff
# the set of failed cases matches this file exactly among executed cases.
